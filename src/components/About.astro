---
import { basics, skills } from "@lib/cv.json"

const { summary } = basics
---

<section id="about" class="about">
	<div class="about-box">
		<span class="box-span">
			Acerca de mí:
		</span>
		<h2 class="box-title">
			Me llamo Henry Azogue, desarrollador Front-end. Mi enfoque está en crear experiencias web intuitivas y atractivas.
		</h2>
		<div class="box-description">
			<p class="description-p">{summary?.[0]}</p>
			<p class="description-p">{summary?.[1]}</p>
		</div>
		<section class="about-skill">
			<h3 class="skill-title">Mi foco como artista esta en el:</h3>
			<div class="skill-box">
				{
				  skills.map(({id, classSpecial, title, description, image, imageAlt})=>(
  				<article class={classSpecial}>
  					<header class="skill-article-header">
  						<span class="skill-article-id">
        				{id}
            		<img class="skill-article-svg" src="/icon-l2.svg" alt="Icono"></span>
  						<h2 class="skill-article-title">{title}</h2>
  						<p class="skill-article-text">{description}</p>
  					</header>
  					<footer class="skill-article-footer">
  						<img class="skill-article-img" src={image} alt={imageAlt}>
  					</footer>
  				</article>
				),
				)}
			</div>
		</section>
	</div>
</section>

<style>
	.about {
		margin: 0 auto;
		width: auto;
		background: radial-gradient(50% 50% at 50% 50%, var(--colore-paarl) 0% 0%, var(--colore-burntUmber) 100% 100%);
		}
	.about-box{
	  padding-block: var(--padding-global-block);
    margin: 0 var(--padding-global-box);
    color: var(--colore-atomicTangerine);
	}
	.box-span{
	  font-size: var(--size-font-text-normal);
		margin: 0;
	}
	.box-title{
  	font-size: var(--size-font-title-section);
  	font-family: var(--font-special);
  	font-weight: 400;
  	letter-spacing: -2px;
  	margin: 13px 0;
    text-wrap: balance;
	}
	.box-description{
	  display: flex;
		flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 1rem;
	}
	.description-p{
	  font-size: var(--size-font-text-normal);
		margin: 0;
		text-wrap: pretty;
	}

	.about-skill{
    padding-top: var(--padding-global-block);
	}
	.skill-title{
    font-size: var(--size-font-title-section);
    margin: 0;
	}
	.skill-box{
    padding-top: var(--padding-global-block);
  	display: flex;
  	flex-direction: column;
    gap: var(--padding-global-block);
	}
	.skill-article-normal{
  	animation: reveal linear both;
  	animation-timeline: view();
  	animation-range: entry 5% cover 28%;
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: center;
    gap: 1rem;
	}
	.skill-article-special{
  	animation: reveal linear both;
  	animation-timeline: view();
  	animation-range: entry 5% cover 28%;
	  display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    text-align: end;
	}
	.skill-article-header{

	}
	.skill-article-id{
	  font-size: clamp(3rem, 2.5357rem + 2.3214vw, 6.25rem);
	  margin: 0;
		font-family: var(--font-special);
	}
	.skill-article-svg{
	  width: clamp(1rem, 0.7857rem + 1.0714vw, 2.5rem);
		height: clamp(1rem, 0.7857rem + 1.0714vw, 2.5rem);
	}
	.skill-article-title{
	  margin: 0;
		font-family: var(--font-special);
		font-size: clamp(1.1875rem, 0.5rem + 3.4375vw, 6rem);
		font-weight: 400;
	}
	.skill-article-text{
	  font-size: var(--size-font-text-normal);
		text-wrap: pretty;
	  margin: 0;
		padding-top: 1rem;
	}
	.skill-article-footer{}
	.skill-article-img{
  	width: clamp(15.75rem, 7.375rem + 41.875vw, 74.375rem);
  	height: clamp(9.375rem, 5.3571rem + 20.0893vw, 37.5rem);
  	object-fit: cover;
    border: 1px solid var(--colore-paarl);
    border-radius: 8px;
    box-shadow:  0px 2px 5px 1px #E591665C;
	}

	@keyframes reveal {
		from {
			opacity: 0;
			translate: 0 250px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (width <= 768px) {
	.box-title{
	letter-spacing: 0;
	}
	.skill-article-normal{
    flex-direction: column-reverse;
	}
	.skill-article-special{
  	flex-direction: column-reverse;
	}
		}
	}
</style>

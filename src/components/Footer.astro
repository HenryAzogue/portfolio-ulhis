---

<footer class="footer">
	<div class="footer-logo">
		<div class="logo-box">
			<img
				class="box-logo-svg"
				src="/icon-l1.svg"
				alt="icono representativo de Henry Azogue"
			/>
			<span class="box-logo-nike">@ulhis</span>
		</div>
		<nav class="navigate-box">
			<li class="box-content">
				<a class="box-link" href="#">| Inicio</a>
			</li>
			<li class="box-content">
				<a class="box-link" href="#projects"
					>| Experiencia</a
				>
			</li>
			<li class="box-content">
				<a class="box-link" href="#about">| Acerca de mí</a>
			</li>
			<li class="box-content">
				<a class="box-link" href="#contact">| Contactame</a>
			</li>
		</nav>
	</div>

	<div class="footer-text">
		<span class="box-logo-text">Portfolio v2</span>
		<span class="box-logo-text-state">
			Disponible
			<img
				class="text-state-svg"
				src="/icon-l4.svg"
				alt="icono de referencia para disponibilidad para trabajos"
			/>
		</span>
		<span class="box-logo-text"
			>Inspiración:
			<a
				class="text-link"
				href="https://www.ozgekeles.com/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Ozge keles
			</a>
		</span>
	</div>
</footer>

<style>
	.footer {
		box-sizing: border-box;
		background-image: url("../assets/footer-portada.avif");
		background-size: cover;
		background-position: 0% 35%;

		display: flex;
		justify-content: space-between;
		align-items: flex-end;

		color: var(--colore-atomicTangerine);
		font-size: var(--size-font-text-special);

		padding: 0 var(--padding-global-box);
		padding-bottom: 2rem;
		width: auto;
		height: clamp(
			31.25rem,
			25.4643rem + 28.9286vw,
			71.75rem
		);
	}
	.footer-logo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.logo-box {
		display: flex;
		flex-direction: column;
		justify-content: center;
		margin-bottom: 7px;
	}
	.box-logo-svg {
		width: var(--sizing-box-logo);
		height: var(--sizing-box-logo);
		color: var(--colore-atomicTangerine);
	}
	.box-logo-nike {
		font-family: var(--font-special);
	}
	.box-logo-text {
	}
	.box-logo-text-state {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1px;
	}
	.text-state-svg {
		color: var(--colore-inchWorn);
		width: var(--sizing-box-icon-decoration);
		height: var(--sizing-box-icon-decoration);
	}

	.navigate-box {
		display: flex;
		gap: 1rem;
	}
	.box-content {
		list-style: none;
	}
	.box-link {
		color: var(--colore-atomicTangerine);
		font-size: var(--size-font-text-special);
		text-decoration: none;
	}
	.box-link:hover {
		color: var(--colore-tamarind);
		transition: color 0.25s ease-in-out;
	}
	.text-link {
		text-decoration: none;
		color: var(--colore-atomicTangerine);
	}

	.footer-text {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
	}
	@media (width <=425px) {
		.footer {
			background-position: 25% 0%;
			flex-direction: row;
		}
		.navigate-box {
			flex-direction: column;
		}
	}
	@media (width <=320px) {
		.footer {
			background-position: 35% 0%;
		}
	}
</style>

---
interface Props {
	titlleSection: string;
}

const { titlleSection } = Astro.props;
---

<h2 class="subtitle">
	{titlleSection}
</h2>

<style>
	.subtitle {
		color: var(--colore-tamarind);
		font-family: var(--font-special);
		font-size: var(--size-font-title-section);
		font-weight: 400;
		margin: 0;
	}
</style>

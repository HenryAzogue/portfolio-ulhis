---
// import Logo from "public/icon-l1.svg";
---

<header class="header">
	<div class="logo">
		<div class="logo-box">
			<img
				class="box-logo-svg"
				src="/icon-l1.svg"
				alt="icono representativo de Henry Azogue"
			/>
			<span class="box-logo-nike">@ulhis</span>
		</div>
		<span class="box-logo-text">Portfolio v2</span>
		<span class="box-logo-text-state">
			Disponible
			<img
				class="text-state-svg"
				src="/icon-l4.svg"
				alt="icono de referencia para disponibilidad para trabajos"
			/>
		</span>
	</div>
	<div class="navigate">
		<nav class="navigate-box">
			<li class="box-content">
				<a class="box-link" href="#">| Inicio</a>
			</li>
			<li class="box-content">
				<a class="box-link" href="#projects"
					>| Experiencia</a
				>
			</li>
			<li class="box-content">
				<a class="box-link" href="#about">| Acerca de mí</a>
			</li>
			<li class="box-content">
				<a class="box-link" href="#contact">| Contactame</a>
			</li>
		</nav>
		<nav class="navigate-box">
			<li class="box-content">
				<a
					class="box-link"
					href="https://drive.google.com/file/d/1JNBQARaW79PMQRXVlfff52Fp_PIt1Kjx/view?usp=sharing"
					target="_blank"
					rel="noreferrer noopener">| Cv</a
				>
			</li>
			<li class="box-content">
				<a
					class="box-link"
					href="mailto:hnrazogue@gmail.com"
					>| Hnrazogue@gmail.com</a
				>
			</li>
		</nav>
	</div>
</header>

<style>
	.header {
		margin: 0 var(--padding-global-box);
		padding-top: 4px;
		display: flex;
		flex-direction: column;
		gap: 82px;
	}

	.logo {
		color: var(--colore-tamarind);
		font-size: var(--size-font-text-special);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.logo-box {
		display: flex;
		flex-direction: column;
		justify-content: center;
		margin-bottom: 7px;
	}
	.box-logo-svg {
		width: var(--sizing-box-logo);
		height: var(--sizing-box-logo);
		color: var(--colore-tamarind);
	}
	.box-logo-nike {
		font-family: var(--font-special);
	}
	.box-logo-text {
	}
	.box-logo-text-state {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1px;
	}
	.text-state-svg {
		color: var(--colore-inchWorn);
		width: var(--sizing-box-icon-decoration);
		height: var(--sizing-box-icon-decoration);
	}

	.navigate {
		display: flex;
		justify-content: space-between;
	}
	.navigate-box {
		display: flex;
		gap: 1rem;
	}
	.box-content {
		list-style: none;
	}
	.box-link {
		color: var(--colore-tamarind);
		font-size: var(--size-font-text-special);
		text-decoration: none;
	}
	.box-link:hover {
		color: var(--colore-burntUmber);
		transition: color 0.25s ease-in-out;
	}

	@media (width <=736px) {
		.navigate {
			display: none;
		}
	}
</style>

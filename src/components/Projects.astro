---
import ButtonArticle from "./ButtonArticle.astro";
import SubTitle from "./SubTitle.astro";
import { projects } from "@lib/cv.json";
---

<section class="project" id="projects">
	<div class="project-header">
		<SubTitle titlleSection="Mis proyectos" />
		<p class="header-text">
			➺ Son el reflejo de los muchos intentos que pasé a lo
			largo de esta travesía - llamado experiencia -.
		</p>
	</div>
	<div class="project-content">
		{
			projects.map(
				({
					title,
					subtitle,
					tags,
					imgPortada,
					imgDescription,
					highlights,
					urlProjects,
					credits,
				}) => {
					return (
						<article class="content-card">
							<div class="card-detail">
								<div class="detail-circul" />
								<div class="detail-circul" />
								<div class="detail-circul" />
							</div>
							<header class="card-header">
								<h2 class="header-title">
									{title} ➺ {subtitle}
								</h2>
							</header>
							<div class="article-body">
								<p class="article-text">
									{highlights?.[0]}
								</p>
								<span class="article-tag">{tags}</span>
								<ButtonArticle urlProjects={urlProjects} />
							</div>
							<footer class="article-footer">
								<img
									src={imgPortada}
									decoding={"async"}
									alt={imgDescription}
									class="footer-image"
								/>
								<p class="footer-credits">{credits}</p>
							</footer>
						</article>
					);
				},
			)
		}
	</div>
</section>

<style>
	.project {
		margin: 0 var(--padding-global-box);
		padding-block: var(--padding-global-block);
	}
	.project-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}
	.header-text {
		font-size: var(--size-font-text-normal);
		color: var(--colore-tamarind);
		width: clamp(
			19.125rem,
			11.2321rem + 39.4643vw,
			74.375rem
		);
		margin: 0;
	}

	.project-content {
		--value-card: clamp(
			19.125rem,
			15.7679rem + 16.7857vw,
			42.625rem
		);
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(var(--value-card), 1fr)
		);
		gap: 1rem;
		padding-top: var(--padding-global-block);
	}

	.content-card {
		color: var(--colore-atomicTangerine);
		border-radius: 8px;
		background-color: var(--colore-tamarind);
		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;
		width: 100%;
		height: auto;

		margin-bottom: 1rem;
	}
	.card-detail {
		background-color: var(--colore-concrete);
		border-radius: 8px 8px 0 0;

		display: flex;
		align-items: center;
		gap: 7px;
		padding: 0 12px;
		height: 24px;
	}
	.detail-circul {
		background-color: #86b9d9;
		border-radius: 50%;
		width: 12px;
		height: 12px;
	}
	.detail-circul:nth-child(1) {
		border-radius: 50%;
		background-color: #deafd4;
		width: 12px;
		height: 12px;
	}
	.detail-circul:nth-child(2) {
		border-radius: 50%;
		background: #d99177;
		width: 12px;
		height: 12px;
	}

	.card-header {
	}
	.header-title {
		font-size: var(--size-font-title-article);
		font-family: var(--font-special);
		letter-spacing: -1px;
		padding: 2rem var(--padding-card-project);
		margin: 0;
	}
	.article-body {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding: 0 var(--padding-card-project);
	}
	.article-text {
		font-size: var(--size-font-text-article);
		letter-spacing: -1px;
		margin: 0;
	}
	.article-tag {
		font-size: var(--size-font-tags);
		font-weight: 200;
		font-style: italic;
		text-align: center;
	}
	.article-footer {
		padding: 2rem var(--padding-card-project);
	}
	.footer-image {
		border-radius: 4px;
		width: 100%;
		height: clamp(
			10.9375rem,
			8.4821rem + 12.2768vw,
			28.125rem
		);
		object-fit: cover;
	}
	.footer-credits {
		font-size: var(--size-font-credits);
		text-align: center;
		margin: 0;
		padding-top: 7px;
		font-size: clamp(0.875rem, 0.7143rem + 0.8036vw, 2rem);
	}

	@keyframes reveal {
		from {
			opacity: 0;
			translate: 0 150px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (width <= 768px) {
		.project-header {
			flex-direction: column;
		}
		.header-text {
			/*width: 100%;*/
		}
		.project-content {
		}
	}
</style>

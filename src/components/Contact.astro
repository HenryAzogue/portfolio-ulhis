---
import Rrss from "./Rrss.astro";
---

<section id="#contact" class="contact">
	<h2 class="contact-title">
		Escríbeme! <br /> y pregunta x* ( + ) información "
	</h2>

	<div class="contact-box">
		<div class="box-legend">
			<a class="legend-p" href="mailto:hnrazogue@gmail.com"
				>hnrazogue@gmail.com</a
			>
			<span class="legend-span">
				<a
					class="legend-span-a"
					href="https://www.linkedin.com/in/henryazogue"
					target="_blank"
					rel="noopener noreferrer">LinkedIn</a
				>
				<a
					class="legend-span-a"
					href="https://www.behance.net/henryazogue"
					target="_blank"
					rel="noopener noreferrer">Behance</a
				>
			</span>
		</div>
		<p class="contact-span">
			Call trans opt: received. 12-15-96 14:32:21 REC:Log ＞
		</p>
	</div>
</section>

<style>
	.contact {
		padding: 236px var(--padding-global-block);
		color: var(--colore-atomicTangerine);
		background-color: var(--colore-tamarind);
	}
	.contact-title {
		font-family: var(--font-special);
		font-size: clamp(2rem, 1.3929rem + 3.0357vw, 6.25rem);
		font-weight: 400;
		letter-spacing: -2px;
		margin: 0;
	}

	.contact-box {
		padding-top: 2rem;
		font-size: var(--size-font-text-normal);
		margin: 0;

		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.box-legend {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		.legend-p {
			margin: 0;
			text-decoration: none;
			color: var(--colore-atomicTangerine);
		}
		.legend-span {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1rem;
			margin: 0;

			.legend-span-a {
				text-decoration: none;
				color: var(--colore-atomicTangerine);
			}
		}
	}
	.contact-span {
		margin: 0;
	}
	@media (width <= 768px) {
		.contact-box {
			flex-direction: column;
		}
	}
</style>

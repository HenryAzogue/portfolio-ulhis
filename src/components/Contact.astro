---
import Rrss from "./Rrss.astro";
---

<section id="#contact" class="contact">
	<h2 class="contact-title">
		Escríbeme! <br /> y pregunta x* ( + ) información "
	</h2>

	<div class="contact-box">
		<div class="box-legend">
			<p class="legend-p">hnrazogue@gmail.com</p>
			<span class="legend-span">LinkedIn Behance</span>
		</div>
		<p class="contact-span">
			Call trans opt: received. 12-15-96 14:32:21 REC:Log ＞
		</p>
	</div>
</section>

<style>
	.contact {
		padding: 236px var(--padding-global-block);
		color: var(--colore-atomicTangerine);
		background-color: var(--colore-tamarind);
	}
	.contact-title {
		font-family: var(--font-special);
		font-size: clamp(2rem, 1.3929rem + 3.0357vw, 6.25rem);
		font-weight: 400;
		letter-spacing: -2px;
		margin: 0;
	}

	.contact-box {
		padding-top: 2rem;
		font-size: var(--size-font-text-normal);
		margin: 0;

		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.box-legend {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		.legend-p {
			margin: 0;
		}
		.legend-span {
			margin: 0;
		}
	}
	.contact-span {
		margin: 0;
	}
	@media (width <= 768px) {
		.contact-box {
			flex-direction: column;
		}
	}
</style>

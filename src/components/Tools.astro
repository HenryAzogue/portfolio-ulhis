---
import SubTitle from "./SubTitle.astro";
import AffinityPhoto from "@icons/AffinityPhoto.astro";
import AstroSvg from "@icons/AstroSvg.astro";
import ReactJs from "@icons/ReactJs.astro";
import Node from "@icons/Node.astro";
import Canva from "@icons/Canva.astro";
import Lunacy from "@icons/Lunacy.astro";
import Vercel from "@icons/Vercel.astro";
import Figma from "@icons/Figma.astro";
import Vite from "@icons/Vite.astro";
import Html from "@icons/Html.astro";
import Js from "@icons/Js.astro";
import Css from "@icons/Css.astro";
import Ts from "@icons/Ts.astro";
import Express from "@icons/Express.astro";
import GitHub from "@icons/GitHub.astro";
import Git from "@icons/Git.astro";
---

<section class="tool">
	<SubTitle titlleSection="Herramientas que utilizo" />
	<div class="parent">
		<div class="div1">
			<h2 class="div1-title">FRONT─END</h2>
			<div class="div1-box">
				<div class="div1-tag">
					<div class="div1-tag-special">
						Html
						<Html />
					</div>
					<div class="div1-tag-special">
						Css
						<Css />
					</div>
					<div class="div1-tag-special">
						Javascript
						<Js />
					</div>
					<div class="div1-tag-special">
						Typescript
						<Ts />
					</div>
				</div>
			</div>
		</div>
		<div class="div2">
			<div class="div2-tag">
				<Express />
				Express
			</div>
			<div class="div2-tag">
				<Node />
				NodeJs
			</div>
			<h2 class="div2-title">BACK<br />─END</h2>
		</div>
		<div class="div3">
			<img
				class="div3-img"
				src="/image/grid-003.webp"
				alt="Imagen de Henry Azogue el chico web developer"
			/>
		</div>
		<div class="div4">
			<AstroSvg />
			<div class="div4-tag">
				<ReactJs />
				React
			</div>
		</div>
		<div class="div5">
			<div class="div5-box">
				<div class="div5-tag">
					GitHub
					<div class="div5-tag-svg">
						<GitHub />
					</div>
				</div>
				<div class="div5-tag">
					Git
					<div class="div5-tag-svg">
						<Git />
					</div>
				</div>
				<div class="div5-tag">
					Vite
					<div class="div5-tag-svg">
						<Vite />
					</div>
				</div><div class="div5-tag">
					Vercel
					<div class="div5-tag-svg">
						<Vercel />
					</div>
				</div>
			</div>
			<div class="div5-content">+ HERRAMIENTAS</div>
		</div>
		<div class="div6">
			<h2 class="div6-title">Diseño</h2>
			<div class="div6-tag">
				<div class="div6-tag-svg">
					<Figma />
				</div>
				Figma
			</div>
			<div class="div6-tag">
				<div class="div6-tag-svg">
					<Lunacy />
				</div>
				Lunacy
			</div>
		</div>
		<div class="div7">
			<h2 class="div7-title">Creatividad</h2>
			<div class="div7-content">
				<div class="div7-svg">
					<Canva />
				</div>
				affinity
			</div>
		</div>
	</div>
</section>

<style>
	.tool {
		margin: 0 var(--padding-global-box);
		padding-block: var(--padding-global-block);
	}
	.parent {
		--grid-row-value: clamp(
			7.8125rem,
			6.4732rem + 6.6964vw,
			17.1875rem
		);
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		grid-template-rows: repeat(15, var(--grid-row-value));
		gap: 10px;
		margin: var(--padding-global-block) 0;
	}

	.div1 {
		grid-row: span 4 / span 4;
		border-radius: var(--b-radius);
		background-image: url("../assets/grid-001.webp");
		background-size: cover;
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2rem;

		.div1-title {
			font-size: var(--size-font-grid-big);
			font-weight: 400;
			font-style: italic;
			color: var(--colore-concrete);
			text-align: center;
			margin: 0;
			letter-spacing: -2px;
		}
		.div1-box {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 1rem;
		}
		.div1-tag {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}
		.div1-tag-special {
			color: var(--colore-atomicTangerine);
			font-size: var(--size-font-grid-normal);
			margin: 0;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 1rem;
		}
	}

	.div2 {
		grid-row-start: 5;
		background: radial-gradient(
			100% 100% at 100% 50%,
			var(--colore-paarl) 86% 0%,
			var(--colore-tamarind) 100% 100%
		);
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1rem;

		.div2-tag {
			color: var(--colore-atomicTangerine);
			font-size: var(--size-font-grid-normal);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1px;
		}

		.div2-title {
			margin: 0;
			font-size: var(--size-font-grid-big);
			font-weight: 400;
			font-style: italic;
			color: var(--colore-concrete);
			letter-spacing: -2px;
		}
	}

	.div3 {
		grid-row: span 2 / span 2;
		grid-row-start: 6;
		background: radial-gradient(
			50% 50% at 50% 50%,
			var(--colore-burntUmber) 0% 0%,
			var(--colore-atomicTangerine) 100% 100%
		);
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		align-items: end;
		.div3-img {
			object-fit: scale-down;
			width: 100%;
			height: 100%;
		}
	}

	.div4 {
		grid-row-start: 8;
		color: var(--colore-atomicTangerine);
		background: radial-gradient(
			50% 50% at 50% 50%,
			var(--colore-burntUmber) 0% 0%,
			var(--colore-paarl) 100% 100%
		);
		background-size: 140%;
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;

		.div4-tag {
			margin: 0;
			font-size: var(--size-font-grid-big);
			color: var(--colore-concrete);
		}
	}

	.div5 {
		grid-row: span 2 / span 2;
		grid-row-start: 9;
		background-image: url("../assets/grid-002.avif");
		background-size: cover;
		background-position: 50% 65%;
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-around;
		gap: 2rem;

		.div5-box {
			display: flex;
			align-items: center;
			justify-content: space-around;
			gap: 1rem;

			.div5-tag {
				color: var(--colore-atomicTangerine);
				font-size: var(--size-font-grid-normal);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 1rem;

				.div5-tag-svg {
					width: 45px;
					height: 45px;
				}
			}
		}
		.div5-content {
			color: var(--colore-concrete);
			font-size: var(--size-font-grid-big);
			letter-spacing: -2px;
			margin: 0;
		}
	}

	.div6 {
		grid-row-start: 11;
		background: radial-gradient(
			50% 50% at 50% 50%,
			var(--colore-paarl) 0% 0%,
			var(--colore-burntUmber) 100% 100%
		);
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		justify-content: space-around;
		align-items: center;

		.div6-title {
			color: var(--colore-atomicTangerine);
			font-family: var(--font-special);
			font-size: var(--size-font-grid-big);
			font-weight: 400;
			letter-spacing: -2px;
			margin: 0;
		}
		.div6-tag {
			font-size: var(--size-font-grid-normal);
			color: var(--colore-atomicTangerine);
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;

			.div6-tag-svg {
				width: 45px;
				height: 44px;
			}
		}
	}

	.div7 {
		grid-row-start: 12;
		grid-row: span 4 / span 4;
		background-image: url("../assets/grid-003.avif");
		background-size: cover;
		background-position: 69% 0%;
		border: solid 1px var(--colore-paarl);
		border-radius: var(--b-radius);

		animation: reveal linear both;
		animation-timeline: view();
		animation-range: entry 5% cover 28%;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;

		.div7-title {
			font-family: var(--font-special);
			font-size: var(--size-font-grid-big);
			font-weight: 400;
			letter-spacing: -2px;
			color: var(--colore-tamarind);
		}

		.div7-content {
			color: #7d2ae7;
			font-size: clamp(
				2.625rem,
				2.375rem + 1.25vw,
				4.375rem
			);
			font-weight: bold;
			letter-spacing: -2px;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 1rem;

			.div7-svg {
				width: clamp(
					9.0625rem,
					8.5714rem + 2.4554vw,
					12.5rem
				);
				height: auto;
			}
		}
	}

	@keyframes reveal {
		from {
			opacity: 0;
			translate: 0 250px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (width >= 768px) {
		.parent {
			--gri-row-value: clamp(
				7.8125rem,
				6.4732rem + 6.6964vw,
				17.1875rem
			);
			grid-template-columns: repeat(3, 1fr);
			grid-template-rows: repeat(5, var(--grid-row-value));
		}
		.div1 {
			grid-row: span 4 / span 4;
		}

		.div2 {
			grid-column-start: 1;
			grid-row-start: 5;
		}

		.div3 {
			grid-row: span 2 / span 2;
			grid-column-start: 2;
			grid-row-start: 1;
		}

		.div4 {
			grid-column-start: 2;
			grid-row-start: 3;
		}

		.div5 {
			grid-row: span 2 / span 2;
			grid-column-start: 2;
			grid-row-start: 4;
		}

		.div6 {
			grid-column-start: 3;
			grid-row-start: 1;
		}

		.div7 {
			grid-row: span 4 / span 4;
			grid-column-start: 3;
			grid-row-start: 2;
		}
	}
</style>
